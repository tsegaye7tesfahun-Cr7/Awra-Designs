{
  "name": "awra-designs-monorepo",
  "version": "1.0.0",
  "description": "Awra Designs - Monorepo for frontend, backend, and admin applications",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "vite": "5.4.11"
  },
  "overrides": {
    "vite": "5.4.11"
  },
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:admin": "npm run build --workspace=apps/admin",
    "start:web": "npm run start --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "start:admin": "npm run preview --workspace=apps/admin"
  },
  "keywords": [
    "monorepo",
    "architecture",
    "interior-design",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
